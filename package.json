{
  "name": "momentum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A calm personal habit tracker — an installable PWA for one person's iPhone.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "TZ=America/New_York vitest run",
    "test:watch": "TZ=America/New_York vitest",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "cp node_modules/@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2 node_modules/@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2 node_modules/@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2 public/fonts/",
    "e2e": "npm run build && playwright test",
    "deploy:firebase": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
